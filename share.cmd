@echo off
setlocal
rem Capture the script folder before the argument loop: shift replaces %0,
rem which would make a later %~dp0 point at the current directory instead.
set "AZEC_SCRIPT_DIR=%~dp0"
cd /d "%AZEC_SCRIPT_DIR%"
set "DO_PUBLISH="
set "QUICK="
set "RUN_TESTS="
:arguments
if "%~1"=="" goto argumentsready
if /I "%~1"=="--help" goto help
if /I "%~1"=="publish" (
    set "DO_PUBLISH=1"
    shift
    goto arguments
)
if /I "%~1"=="quick" (
    set "QUICK=1"
    shift
    goto arguments
)
if /I "%~1"=="test" (
    set "RUN_TESTS=1"
    shift
    goto arguments
)
echo Unknown argument: %~1
goto usage
:argumentsready
if defined QUICK if defined DO_PUBLISH goto usage

set "AZEC_SHARE_ROOT=%AZEC_SCRIPT_DIR%"
rem Quick repackaging must retain the compiled app's version.
if defined QUICK (
    if not exist .build\share-build\version.txt (
        echo Run share.cmd once before using quick.
        exit /b 1
    )
    set /p VERSION=<.build\share-build\version.txt
    goto tools
)
rem ---------------------------------------------------------------- version
set "VERSION="
for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command "[DateTime]::UtcNow.ToString('yyyy.MM.dd.HHmmss')"`) do set "VERSION=%%T"
if not defined VERSION (
    echo Could not generate the release version.
    exit /b 1
)
rem ------------------------------------------------------------------ tools
:tools
if not defined NEON_QT_ROOT set "NEON_QT_ROOT=%LOCALAPPDATA%\NeonManagerR6\Qt\6.8.3\msvc2022_64"
if not exist "%NEON_QT_ROOT%\bin\qmake.exe" (
    echo Qt 6.8.3 is missing. Run setup-qt.ps1 first, or set NEON_QT_ROOT.
    exit /b 1
)
if not exist "%NEON_QT_ROOT%\bin\windeployqt.exe" (
    echo Qt deployment tools are missing. Run setup-qt.ps1 or select a complete Qt kit.
    exit /b 1
)
if not exist .build mkdir .build
"%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath > .build\share-vs.txt
set "R6_VS="
set /p R6_VS=<.build\share-vs.txt
if not defined R6_VS exit /b 1
set "PATH=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer;%PATH%"
call "%R6_VS%\Common7\Tools\VsDevCmd.bat" -arch=x64 -host_arch=x64 -startdir=none
if errorlevel 1 exit /b 1
set "PATH=%NEON_QT_ROOT%\bin;%PATH%"
where cl.exe > nul 2> nul
if errorlevel 1 exit /b 1
where nmake.exe > nul 2> nul
if errorlevel 1 exit /b 1
where rc.exe > nul 2> nul
if errorlevel 1 exit /b 1
where link.exe > nul 2> nul
if errorlevel 1 exit /b 1
(
echo #pragma once
echo // Generated by share.cmd for a packaged build. Manual builds keep the value they find here.
echo #define AZEC_VERSION "%VERSION%"
) > "src\version.hpp"
if errorlevel 1 exit /b 1

rem ------------------------------------------------------------- application
if defined QUICK goto skipbuild
if not exist .build\share-build mkdir .build\share-build
pushd .build\share-build
"%NEON_QT_ROOT%\bin\qmake.exe" "%AZEC_SCRIPT_DIR%Azec.pro" -o Makefile
if errorlevel 1 ( popd & exit /b 1 )
nmake /nologo
if errorlevel 1 ( popd & exit /b 1 )
popd
> .build\share-build\version.txt echo %VERSION%
:skipbuild
if not exist .build\share-build\release\Azec.exe (
    echo No application build found. Run share.cmd without "quick" first.
    exit /b 1
)

rem -------------------------------------------------------- stage the payload
set "PAYLOAD=%AZEC_SCRIPT_DIR%.build\share-payload"
powershell -NoProfile -Command "$root=[IO.Path]::GetFullPath($env:AZEC_SHARE_ROOT); $target=[IO.Path]::GetFullPath((Join-Path $root '.build\share-payload')); if(-not $target.StartsWith((Join-Path $root '.build\'),[StringComparison]::OrdinalIgnoreCase)){throw 'Unsafe staging path'}; if(Test-Path -LiteralPath $target){Remove-Item -LiteralPath $target -Recurse -Force}"
if errorlevel 1 exit /b 1
mkdir "%PAYLOAD%\runtime"
copy /y ".build\share-build\release\Azec.exe" "%PAYLOAD%\runtime\Azec.exe" > nul
if errorlevel 1 exit /b 1
"%NEON_QT_ROOT%\bin\windeployqt.exe" --release --no-translations --no-opengl-sw --no-system-d3d-compiler --no-compiler-runtime --skip-plugin-types generic,networkinformation,styles --dir "%PAYLOAD%\runtime" "%PAYLOAD%\runtime\Azec.exe"
if errorlevel 1 exit /b 1
set "R6_CRT="
for /d %%D in ("%VCToolsRedistDir%x64\Microsoft.VC*.CRT") do set "R6_CRT=%%~fD"
if not defined R6_CRT (
    echo Visual C++ redistributable files were not found.
    exit /b 1
)
copy /y "%R6_CRT%\*.dll" "%PAYLOAD%\runtime\" > nul
if errorlevel 1 exit /b 1
xcopy /e /i /y "licenses" "%PAYLOAD%\licenses" > nul
if errorlevel 1 exit /b 1

rem ------------------------------------------------- pack and build one exe
if exist .build\share-payload.zip del /q .build\share-payload.zip
powershell -NoProfile -Command "Compress-Archive -Path '%PAYLOAD%\*' -DestinationPath '.build\share-payload.zip' -Force"
if errorlevel 1 exit /b 1
if not exist dist mkdir dist
del /q "dist\Azec.exe" "dist\SHA256SUMS.txt" 2> nul
pushd .build
> share-payload.rc echo 1 ICON "app.ico"
>> share-payload.rc echo AZEC_PAYLOAD RCDATA "share-payload.zip"
rc /nologo /I "..\assets" /fo share-payload.res share-payload.rc
if errorlevel 1 ( popd & exit /b 1 )
cl /nologo /std:c++17 /O2 /EHsc /MT /DUNICODE /D_UNICODE ..\src\launcher.cpp share-payload.res /Fe:"..\dist\Azec.exe" /link /SUBSYSTEM:WINDOWS user32.lib shell32.lib ole32.lib uuid.lib
if errorlevel 1 ( popd & exit /b 1 )
popd

rem --------------------------------------------------------- smoke test
if /I "%AZEC_SKIP_TESTS%"=="1" (
    echo Installer smoke test skipped: AZEC_SKIP_TESTS=1.
    goto publishing
)
if not defined RUN_TESTS (
    echo Installer smoke test skipped. Add test to request it explicitly.
    goto publishing
)
python tests\installation_test.py --smoke
if errorlevel 1 exit /b 1

rem ------------------------------------------------------------- publishing
:publishing
if not defined DO_PUBLISH goto report
gh repo view Azec-Zuckerberg/Azec-releases > nul 2>&1
if errorlevel 1 (
    echo Creating the public releases repository Azec-Zuckerberg/Azec-releases ...
    gh repo create Azec-Zuckerberg/Azec-releases --public --description "Azec portable release builds" --add-readme
    if errorlevel 1 exit /b 1
)
gh release create "v%VERSION%" "dist\Azec.exe" --repo Azec-Zuckerberg/Azec-releases --title "Azec %VERSION%" --notes "Open Azec.exe to install and launch for your Windows user. Find Azec in Start afterward. Profiles are kept separately in LocalAppData\Azec and preserved by Settings - Updates."
if errorlevel 1 exit /b 1
powershell -NoProfile -File "%AZEC_SCRIPT_DIR%verify-release.ps1" -Version "%VERSION%"
if errorlevel 1 exit /b 1

:report
echo.
echo Built dist\Azec.exe   (Azec %VERSION%)
echo Send that single file. Your friend opens it, then finds Azec in Start.
if defined DO_PUBLISH echo https://github.com/Azec-Zuckerberg/Azec-releases/releases/latest/download/Azec.exe
endlocal
exit /b 0

:help
echo Usage: share.cmd [quick ^| publish] [test]
echo Packages without tests by default. Add test to run the installer smoke test.
exit /b 0

:usage
echo Usage: share.cmd [quick ^| publish] [test]
exit /b 2
